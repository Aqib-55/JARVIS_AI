# ============================================================
# JARVIS AI — Environment Configuration Example
# ============================================================
# Copy this file to .env and configure your local settings:
#   copy .env.example .env
#
# NEVER commit the .env file to Git.
# This file contains NO secrets — only placeholders.

# ------ AI Provider (Ollama — local only) ------
AI_PROVIDER=ollama
LOCAL_AI_ONLY=true

# ------ Ollama Configuration ------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOOL_CALLS=5

# ------ Application Settings ------
LOG_LEVEL=INFO
MAX_CONVERSATION_HISTORY=20
MAX_TOOL_CALLS_PER_TASK=10

# ------ Voice — Speech Recognition (Faster-Whisper) ------
VOICE_ENABLED=true
VOICE_INPUT_ENABLED=true
VOICE_STT_PROVIDER=faster_whisper
WHISPER_MODEL=base
WHISPER_MODEL_PATH=models/stt/faster-whisper-base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto

# ------ Voice — Speech Synthesis (Piper TTS) ------
VOICE_TTS_PROVIDER=piper
VOICE_OUTPUT_ENABLED=true
PIPER_MODEL_PATH=models/tts
PIPER_VOICE=en_GB-alan-medium
TTS_VOLUME=1.0
TTS_SPEED=1.0

# ------ Wake Word & Hands-Free Conversation ------
WAKE_WORD_ENABLED=true
WAKE_WORD_PHRASE=hey jarvis
WAKE_WORD_ENGINE=openwakeword
WAKE_WORD_THRESHOLD=0.5
WAKE_WORD_MODEL_DIR=models/wakeword
VOICE_MICROPHONE_INDEX=
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1
VOICE_SILENCE_TIMEOUT_SECONDS=1.0
VOICE_MAX_UTTERANCE_SECONDS=20
VOICE_MIN_SPEECH_SECONDS=0.3
CONVERSATION_TIMEOUT_SECONDS=25

# ------ Voice Mode ------
VOICE_MODE=hands_free
